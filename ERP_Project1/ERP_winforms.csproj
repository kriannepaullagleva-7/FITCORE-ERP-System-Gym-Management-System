<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ERP_Project1</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Colors\Shades.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Colors\Shades.cs" />
  </ItemGroup>

  <!--
    FitCore's desktop client is a pure ERP_api consumer. It deliberately references neither
    ERP_infrastructure nor Entity Framework: the only way it reaches business data is HTTP/JSON
    to the API, which owns tenant resolution, authorisation and the business rules. Adding an
    EF or infrastructure reference here would let a screen bypass all three.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Optional per-machine override, gitignored, for pointing at a different API host. -->
    <None Update="appsettings.Local.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
