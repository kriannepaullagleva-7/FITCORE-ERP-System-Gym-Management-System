{
  // FitCore desktop client.
  //
  // This application is a pure ERP_api consumer: it holds no connection string and never
  // opens a database. The API owns tenancy, authentication, authorisation and the business
  // rules, so the only thing the desktop needs to know is where to find it.
  //
  // Override per machine with appsettings.Local.json (gitignored) if the API runs elsewhere.
  "ApiBaseUrl": "https://localhost:7214/"
}
