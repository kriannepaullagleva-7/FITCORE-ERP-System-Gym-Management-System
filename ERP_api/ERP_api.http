### ---------------------------------------------------------------------------------------
### System administration (master database)
### All of these require Tenancy:EnableCrossTenantAdminApi, otherwise 403.
### ---------------------------------------------------------------------------------------

GET {{ERP_api_HostAddress}}/api/companies
Accept: application/json

###
GET {{ERP_api_HostAddress}}/api/companies/databases
Accept: application/json

###
POST {{ERP_api_HostAddress}}/api/companies
Content-Type: application/json

{
  "companyCode": "COMP003",
  "companyName": "Second Gym",
  "isActive": true
}

###
POST {{ERP_api_HostAddress}}/api/companies/databases
Content-Type: application/json

{
  "companyId": 3,
  "serverName": "db68433.public.databaseasp.net",
  "databaseName": "db68433",
  "credentialKey": "TenantA",
  "isActive": true
}

###
GET {{ERP_api_HostAddress}}/api/companies/devices
Accept: application/json

### Tenant provisioning (admin). Registering a company only records where its database
### lives; this applies the tenant migrations to it. Idempotent.

GET {{ERP_api_HostAddress}}/api/companies/3/provisioning
Accept: application/json

###
POST {{ERP_api_HostAddress}}/api/companies/1/provision
