{
    try
    {
        var items = dto.Items.Select(i => (i.ProductId, i.Quantity, i.UnitPrice)).ToList();
        var sale = await service.CreateSaleAsync(dto.MemberId, items);
        return Results.Created($"/fitcore/3/sales/{sale.SaleId}", sale.ToDto());
    }
    catch (InvalidOperationException ex)
    {
        return Results.BadRequest(new { error = ex.Message });
    }
})
