app.MapPost("/fitcore/3/payments", async (ERP_api.DTOs.RecordPaymentDto dto, IPaymentService service) =>
{
    try
    {
        var payment = await service.RecordPaymentAsync(
            dto.MemberId,
            dto.SubscriptionId,
            dto.Amount,
            dto.PaymentDate ?? DateTime.UtcNow,
            dto.Method,
            dto.ReferenceNo,
            dto.Status,
            dto.Notes);

        return Results.Created($"/fitcore/3/payments/{payment.PaymentId}", payment.ToDto());
    }
    catch (InvalidOperationException ex)
    {
        return Results.BadRequest(new { error = ex.Message });
    }
})
.WithName("RecordPayment")
.WithOpenApi();

app.MapPut("/fitcore/3/payments/{id}", async (int id, ERP_api.DTOs.UpdatePaymentDto dto, IPaymentService service) =>
{
    try
    {
        var payment = await service.UpdatePaymentAsync(
            id, dto.Amount, dto.PaymentDate ?? default, dto.Method, dto.ReferenceNo, dto.Status, dto.Notes);

        if (payment == null) return Results.NotFound();
        return Results.Ok(payment.ToDto());
    }
    catch (InvalidOperationException ex)
    {
        return Results.BadRequest(new { error = ex.Message });
    }
})
.WithName("UpdatePayment")
.WithOpenApi();

app.MapPatch("/fitcore/3/payments/{id}/status", async (int id, ERP_api.DTOs.UpdatePaymentStatusDto dto, IPaymentService service) =>
{
    try
    {
        var payment = await service.UpdatePaymentStatusAsync(id, dto.Status);
        if (payment == null) return Results.NotFound();
        return Results.Ok(payment.ToDto());
    }
    catch (InvalidOperationException ex)
    {
        return Results.BadRequest(new { error = ex.Message });
    }
})
.WithName("UpdatePaymentStatus")
.WithOpenApi();

app.MapDelete("/fitcore/3/payments/{id}", async (int id, IPaymentService service) =>
{
    var success = await service.DeletePaymentAsync(id);
    if (!success) return Results.NotFound();
    return Results.NoContent();
})
.WithName("DeletePayment")
.WithOpenApi();

