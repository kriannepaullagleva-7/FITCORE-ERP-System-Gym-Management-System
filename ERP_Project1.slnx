<Solution>
  <!-- FitCore ERP is a desktop product. ERP_winforms is the only user-facing application and
       is listed first so Visual Studio and the Package Manager Console default to it.

       ERP_api remains the backend: the desktop client reaches all business data over
       HTTP/JSON, and the API owns tenant resolution, authorisation and the business rules.

       Note the folder/assembly mismatch on the first entry: the WinForms project lives in the
       ERP_Project1 folder but is named ERP_winforms.csproj. -->
  <Project Path="ERP_Project1/ERP_winforms.csproj" />
  <Project Path="ERP_api/ERP_api.csproj" Id="e35dc5d4-3db4-4a1c-b73e-7fed7a492061" />
  <Project Path="ERP_infrastructure/ERP_infrastructure.csproj" Id="5f037f10-0ae0-4290-8245-1d119d2457f0" />
  <Project Path="ERP_domain/ERP_domain.csproj" Id="ba5134c5-f3fd-4c2e-90fc-e90f2e049148" />
  <Project Path="ERP_Tests/ERP_Tests.csproj" />
</Solution>
