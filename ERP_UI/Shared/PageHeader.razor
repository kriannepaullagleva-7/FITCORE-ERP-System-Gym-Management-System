@*
    The heading block every module page starts with: optional breadcrumbs, a title, a short
    description and a slot for the page-level actions. Having one component means the spacing
    and type scale cannot drift between modules.
*@

<div class="fc-page-head">
    <div>
        @if (Crumbs is not null && Crumbs.Count > 0)
        {
            <nav class="fc-crumbs" aria-label="Breadcrumb">
                <a href="fitcore/dashboard">Home</a>
                @foreach (var crumb in Crumbs)
                {
                    <span class="fc-crumb-sep">/</span>
                    @if (string.IsNullOrEmpty(crumb.Href))
                    {
                        <span>@crumb.Label</span>
                    }
                    else
                    {
                        <a href="@crumb.Href">@crumb.Label</a>
                    }
                }
            </nav>
        }

        <h1 class="fc-page-title">@Title</h1>

        @if (!string.IsNullOrWhiteSpace(Description))
        {
            <p class="fc-page-sub">@Description</p>
        }
    </div>

    @if (Actions is not null)
    {
        <div class="fc-page-actions">@Actions</div>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string? Description { get; set; }
    [Parameter] public List<Crumb>? Crumbs { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }

    public record Crumb(string Label, string? Href = null);
}
