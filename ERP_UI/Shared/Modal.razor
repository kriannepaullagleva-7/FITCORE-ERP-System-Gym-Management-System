@*
    A dialog. Closing is driven by the parent through OnClose so the parent keeps ownership
    of its own form state; this component only draws the frame.
*@

@if (IsOpen)
{
    <div class="fc-backdrop" @onclick="BackdropClicked">
        <div class="fc-modal @SizeClass" role="dialog" aria-modal="true" aria-label="@Title"
             @onclick:stopPropagation="true">
            <div class="fc-modal-head">
                <div>
                    <h2 class="fc-modal-title">@Title</h2>
                    @if (!string.IsNullOrWhiteSpace(Subtitle))
                    {
                        <p class="fc-modal-sub">@Subtitle</p>
                    }
                </div>
                <button type="button" class="fc-close" @onclick="OnClose" aria-label="Close">&times;</button>
            </div>

            <div class="fc-modal-body">
                @ChildContent
            </div>

            @if (Footer is not null)
            {
                <div class="fc-modal-foot">@Footer</div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string? Subtitle { get; set; }

    /// <summary>normal, wide or narrow.</summary>
    [Parameter] public string Size { get; set; } = "normal";

    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Footer { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    /// <summary>
    /// Off by default for forms: clicking past a half-filled form and losing the input is a
    /// worse outcome than having to aim for the Cancel button.
    /// </summary>
    [Parameter] public bool CloseOnBackdropClick { get; set; }

    private string SizeClass => Size switch
    {
        "wide" => "is-wide",
        "narrow" => "is-narrow",
        _ => ""
    };

    private async Task BackdropClicked()
    {
        if (CloseOnBackdropClick) await OnClose.InvokeAsync();
    }
}
